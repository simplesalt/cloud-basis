{
  "name": "ssint-main-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Auth-only remote MCP server (Cloudflare Worker) for simplesalt/cloud-basis, deployed as a Crossplane Script.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bash build.sh",
    "bundle": "node scripts/bundle.mjs",
    "generate": "node scripts/generate-worker-script.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/server": "2.2.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3"
  }
}
