#!/usr/bin/env bash
# Keeps 30-mcp/worker-script.yaml from drifting out of sync with
# workers/mcp-server/src: when this commit touches either, rebuild the
# Worker and refuse the commit unless the staged manifest already matches
# what the current sources produce.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

MANIFEST="30-mcp/worker-script.yaml"

STAGED_FILES="$(git diff --cached --name-only)"
if ! printf '%s\n' "$STAGED_FILES" | grep -qE '^(workers/mcp-server/|30-mcp/worker-script\.yaml$)'; then
  exit 0
fi

STAGED_MANIFEST="$(git show ":$MANIFEST" 2>/dev/null || true)"

bash workers/mcp-server/build.sh >&2

CURRENT_MANIFEST="$(cat "$MANIFEST" 2>/dev/null || true)"

if [[ "$STAGED_MANIFEST" != "$CURRENT_MANIFEST" ]]; then
  cat >&2 <<'EOF'
error: 30-mcp/worker-script.yaml is out of date with workers/mcp-server/src.

workers/mcp-server/build.sh just regenerated it in the working tree from
the currently staged sources. Review the change, then:

  git add 30-mcp/worker-script.yaml

and commit again.
EOF
  exit 1
fi

exit 0
